# Copy to .env and edit before running docker compose.
# Endpoint that receives the per-flow feature records.
CIC_API_URL=http://127.0.0.1:5000/api/v1/process_stream
# Set to true to actually post records. Leaved false for a capture-only run.
CIC_API_ENABLED=false
# Keep writing CSV files in the mounted data directory.
CIC_CSV_ENABLED=true
